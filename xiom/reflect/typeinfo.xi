// fn type_name[T]() -> Str - the name of type T. TODO(compiler): implement.
// fn type_id[T]() -> Int - a stable numeric id for type T. TODO(compiler): implement.
// fn type_size[T]() -> Int - the size of type T in bytes. TODO(compiler): implement.
// fn type_align[T]() -> Int - the alignment of type T in bytes. TODO(compiler): implement.
// fn type_is_primitive[T]() -> Bool - whether T is a primitive type. TODO(compiler): implement.
// fn type_is_struct[T]() -> Bool - whether T is a struct type. TODO(compiler): implement.
// fn type_is_enum[T]() -> Bool - whether T is an enum type. TODO(compiler): implement.
// fn type_is_generic[T]() -> Bool - whether T is a generic type. TODO(compiler): implement.
// fn type_of[T](value: T) -> Str - the type name of a value. TODO(compiler): implement.
// fn type_variant_count[T]() -> Int - the number of enum variants of T, or 0. TODO(compiler): implement.
// fn type_is_sized[T]() -> Bool - whether T has a known size. TODO(compiler): implement.
