module xiom.math.transcendental

// Depends on: none

// ============================================================================
// Exponential, logarithmic, power, and special transcendental functions. TODO(compiler): implement.
// ============================================================================

// fn sqrt(x: Float64) -> Float64 - square root; requires x >= 0.
// fn cbrt(x: Float64) -> Float64 - cube root.
// fn exp(x: Float64) -> Float64 - e^x.
// fn exp2(x: Float64) -> Float64 - 2^x.
// fn expm1(x: Float64) -> Float64 - e^x - 1, accurate for small x.
// fn ln(x: Float64) -> Float64 - natural logarithm; requires x > 0.
// fn log2(x: Float64) -> Float64 - base-2 logarithm; requires x > 0.
// fn log10(x: Float64) -> Float64 - base-10 logarithm; requires x > 0.
// fn log1p(x: Float64) -> Float64 - ln(1 + x), accurate for small x.
// fn pow(a: Float64, b: Float64) -> Float64 - a raised to the power b.
// fn pow_int(a: Float64, n: Int) -> Float64 - a raised to the integer power n.
// fn root(x: Float64, n: Int) -> Float64 - n-th root of x.
// fn gamma(x: Float64) -> Float64 - gamma function.
// fn lgamma(x: Float64) -> (Float64, Int) - log-gamma; tuple is (ln|gamma(x)|, sign).
// fn erf(x: Float64) -> Float64 - error function.
// fn erfc(x: Float64) -> Float64 - complementary error function, 1 - erf(x).
// fn lambert_w(x: Float64) -> Float64 - principal branch of the Lambert W function.
