module xiom.math.trig

// Depends on: none

// ============================================================================
// Trigonometric and hyperbolic functions, radians/degrees conversion. TODO(compiler): implement.
// ============================================================================

// fn sin(x: Float64) -> Float64 - sine of x in radians.
// fn cos(x: Float64) -> Float64 - cosine of x in radians.
// fn tan(x: Float64) -> Float64 - tangent of x in radians.
// fn asin(x: Float64) -> Float64 - arc sine; requires x in [-1, 1].
// fn acos(x: Float64) -> Float64 - arc cosine; requires x in [-1, 1].
// fn atan(x: Float64) -> Float64 - arc tangent.
// fn atan2(y: Float64, x: Float64) -> Float64 - arc tangent of y/x with quadrant correction.
// fn sinh(x: Float64) -> Float64 - hyperbolic sine.
// fn cosh(x: Float64) -> Float64 - hyperbolic cosine.
// fn tanh(x: Float64) -> Float64 - hyperbolic tangent.
// fn asinh(x: Float64) -> Float64 - inverse hyperbolic sine.
// fn acosh(x: Float64) -> Float64 - inverse hyperbolic cosine; requires x >= 1.
// fn atanh(x: Float64) -> Float64 - inverse hyperbolic tangent; requires x in (-1, 1).
// fn sec(x: Float64) -> Float64 - secant, 1 / cos(x).
// fn csc(x: Float64) -> Float64 - cosecant, 1 / sin(x).
// fn cot(x: Float64) -> Float64 - cotangent, cos(x) / sin(x).
// fn degrees(x: Float64) -> Float64 - convert radians to degrees.
// fn radians(x: Float64) -> Float64 - convert degrees to radians.
// fn sin_deg(x: Float64) -> Float64 - sine of x in degrees.
// fn cos_deg(x: Float64) -> Float64 - cosine of x in degrees.
// fn tan_deg(x: Float64) -> Float64 - tangent of x in degrees.
