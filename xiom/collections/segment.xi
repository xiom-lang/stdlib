module xiom.collect.segment

// Depends on: none (pure)

// ============================================================================
// Segment tree over an Int array (0-based indices). Builds in O(n), supports
// point updates and range queries (sum, min, max) in O(log n). Indices are
// inclusive; out-of-range queries return identity values (0 for sum,
// INT_MAX for min, INT_MIN for max).
// ============================================================================

// fn segtree_new(n: Int) - create a segment tree over n zero slots. TODO(compiler): implement.
// fn segtree_build(t, values: &Vec[Int]) - build internal nodes from the given values. TODO(compiler): implement.
// fn segtree_update(t, idx: Int, value: Int) - set slot idx to value. TODO(compiler): implement.
// fn segtree_query_sum(t, l: Int, r: Int) -> Int - sum over [l, r] inclusive. TODO(compiler): implement.
// fn segtree_query_min(t, l: Int, r: Int) -> Int - minimum over [l, r] inclusive. TODO(compiler): implement.
// fn segtree_query_max(t, l: Int, r: Int) -> Int - maximum over [l, r] inclusive. TODO(compiler): implement.
// fn segtree_size(t) -> Int - number of slots. TODO(compiler): implement.
