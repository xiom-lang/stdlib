module xiom.collect.interval

// ============================================================================
// Interval tree (Int start/end, Int value). Stores [start, end] intervals and
// answers stabbing queries (which intervals contain a point) and range queries
// (which intervals overlap [start, end]) in O(log n + k) where k is the number
// of reported intervals. Intervals are inclusive on both ends.
// ============================================================================

// fn interval_tree_new() - create an empty interval tree. TODO(compiler): implement.
// fn interval_insert(t, start: Int, end: Int, value: Int) - insert an interval. TODO(compiler): implement.
// fn interval_query(t, point: Int) -> Vec[Int] - values of intervals containing point. TODO(compiler): implement.
// fn interval_range_query(t, start: Int, end: Int) -> Vec[Int] - values of intervals overlapping [start, end]. TODO(compiler): implement.
// fn interval_remove(t, start: Int, end: Int) -> Bool - remove matching interval; true if found. TODO(compiler): implement.
// fn interval_size(t) -> Int - number of intervals. TODO(compiler): implement.
// fn interval_contains_point(t, point: Int) -> Bool - true if any interval contains point. TODO(compiler): implement.
// fn interval_overlaps(t, start: Int, end: Int) -> Bool - true if any interval overlaps the range. TODO(compiler): implement.
