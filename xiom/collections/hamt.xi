module xiom.collect.hamt

// Depends on: none (pure)

// ============================================================================
// Hash array mapped trie (Int keys, Int values). A space-efficient persistent
// map built on a trie of 32-way nodes using the hash of the key. Average
// O(log_32 n) operations with fast structural sharing and cache locality.
// Duplicate keys are rejected by insert.
// ============================================================================

// fn hamt_new() - create an empty HAMT. TODO(compiler): implement.
// fn hamt_insert(h, key: Int, value: Int) -> Bool - insert key/value; false if key exists. TODO(compiler): implement.
// fn hamt_get(h, key) -> Option[Int] - value for key, or None. TODO(compiler): implement.
// fn hamt_contains(h, key) -> Bool - true if key is present. TODO(compiler): implement.
// fn hamt_remove(h, key) -> Bool - remove key; true if it was present. TODO(compiler): implement.
// fn hamt_size(h) -> Int - number of key/value pairs. TODO(compiler): implement.
// fn hamt_clear(h) - remove all entries. TODO(compiler): implement.
