module xiom.collect.pairingheap

// Depends on: none (pure)

// ============================================================================
// Pairing heap (Int priorities) - a simple amortized O(log n) meldable heap.
// Supports push, pop-min, peek, size, merge and decrease-key in O(1) amortized
// for merge/meld operations. Ties are broken arbitrarily (min-heap semantics).
// ============================================================================

// fn pheap_new() - create an empty pairing heap. TODO(compiler): implement.
// fn pheap_push(h, priority: Int) - insert a priority. TODO(compiler): implement.
// fn pheap_pop(h) -> Option[Int] - remove and return the minimum priority, or None. TODO(compiler): implement.
// fn pheap_peek(h) -> Option[Int] - return the minimum priority without removing, or None. TODO(compiler): implement.
// fn pheap_size(h) -> Int - number of priorities. TODO(compiler): implement.
// fn pheap_merge(a, b) -> heap - meld two heaps into one; a and b are consumed. TODO(compiler): implement.
// fn pheap_decrease_key(h, node, new_priority) - lower the priority of an existing node. TODO(compiler): implement.
// fn pheap_is_empty(h) -> Bool - true if the heap has no priorities. TODO(compiler): implement.
