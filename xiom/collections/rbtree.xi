module xiom.collect.rbtree

// Depends on: none (pure)

// ============================================================================
// Red-black tree (Int keys, Int values). Self-balancing BST with a color bit
// per node (red/black) that guarantees O(log n) insert, delete and lookup.
// Duplicate keys are rejected; inorder/preorder/postorder return the keys.
// ============================================================================

// fn rbtree_new() - create an empty red-black tree. TODO(compiler): implement.
// fn rbtree_insert(t, key: Int, value: Int) -> Bool - insert key/value pair; false if key exists. TODO(compiler): implement.
// fn rbtree_get(t, key) -> Option[Int] - value for key, or None. TODO(compiler): implement.
// fn rbtree_contains(t, key) -> Bool - true if key is present. TODO(compiler): implement.
// fn rbtree_remove(t, key) -> Bool - remove key; true if it was present. TODO(compiler): implement.
// fn rbtree_size(t) -> Int - number of keys. TODO(compiler): implement.
// fn rbtree_min(t) -> Option[Int] - smallest key, or None. TODO(compiler): implement.
// fn rbtree_max(t) -> Option[Int] - largest key, or None. TODO(compiler): implement.
// fn rbtree_inorder(t) -> Vec[Int] - keys in ascending order. TODO(compiler): implement.
// fn rbtree_preorder(t) -> Vec[Int] - keys in preorder (node, left, right). TODO(compiler): implement.
// fn rbtree_postorder(t) -> Vec[Int] - keys in postorder (left, right, node). TODO(compiler): implement.
