# C Standard Library FFI Bindings

library "libc" {
  fn malloc(size: u64) -> ptr;
  fn free(ptr: ptr);
  fn strlen(s: str) -> u64;
  fn strcmp(a: str, b: str) -> i32;
  fn printf(format: str, ...) -> i32;
}

library "libm" {
  fn sqrt(x: f64) -> f64;
  fn pow(base: f64, exp: f64) -> f64;
  fn sin(x: f64) -> f64;
  fn cos(x: f64) -> f64;
  fn tan(x: f64) -> f64;
  fn asin(x: f64) -> f64;
  fn acos(x: f64) -> f64;
  fn atan(x: f64) -> f64;
  fn atan2(y: f64, x: f64) -> f64;
  fn exp(x: f64) -> f64;
  fn log(x: f64) -> f64;
  fn log10(x: f64) -> f64;
  fn floor(x: f64) -> f64;
  fn ceil(x: f64) -> f64;
  fn fabs(x: f64) -> f64;
  fn fmod(x: f64, y: f64) -> f64;
}

# Windows: link ucrt (automatic with MSVC)
# Linux:   link -lm (add to compile flags)
# macOS:   libm is part of libSystem (automatic)
