# Build/test artifacts generated inside the stdlib tree (runtime shims, smoke
# executables, IR dumps). The compiler repo ignores the whole stdlib/ checkout
# post-split; this file travels with the stdlib repo.
*.exe
*.exe.ll
*.ll
*.o
*.obj
*.pdb
*.dll
*.so
*.dylib
*.lib
*.a
*.bc
*.wat
*.wasm
*.tmp
*.log

# tools/probes/ versions ONLY the .xi probe corpus (the verification locks
# referenced by the session handoff and CI). Run captures (.out/.err/.log),
# IR dumps and debug patches are output, never source.
tools/probes/*
!tools/probes/*.xi
tools/_work/
tools/out/

# Editor / OS / local agent state
.DS_Store
Thumbs.db
*.code-workspace
kilo.jsonc
.kilo/worktrees/
.vscode/
.idea/

# Python tooling caches (CI helpers)
__pycache__/
*.pyc
.venv/
