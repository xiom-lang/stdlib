  authors: ["AXIOM Team"];
  modules: [
    "axiom.core",
    "axiom.io",
    "axiom.collections",
    "axiom.string",
    "axiom.math",
    "axiom.ffi",
    "axiom.async",
    "axiom.net",
    "axiom.os",
    "axiom.time",
    "axiom.sync",
    "axiom.iter",
    "axiom.test",
    "axiom.serialize",
    "axiom.bench",
    "axiom.log",
    "axiom.contracts",
  ];
}
